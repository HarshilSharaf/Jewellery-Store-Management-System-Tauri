{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the desktop application",
  "windows": ["main", "splashscreen"],
  "permissions": [
    "core:default",
    "core:path:default",
    "process:default",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-write-file",
    "fs:scope-picture-recursive",
    "log:default",
    "sql:default",
    "store:default"
  ]
}
